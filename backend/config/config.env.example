# Render backend environment variables
NODE_ENV=production
# Render provides PORT automatically; do not hardcode it.
DB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=90d
JWT_EXPIRES_TIME=90
FRONTEND_URL=https://your-frontend.vercel.app

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_API_KEY=pk_test_replace_me

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GROQ_API_KEY=

# Optional: only required for SMTP email features
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
